# VRUKSHA Farm To Home — Server Configuration Template
# Duplicate this file to .env and configure secret keys securely.

# Environment Mode (production | development | test)
NODE_ENV=development

# Server Port
PORT=5000

# Trusted Frontend Client URL for CORS Whitelisting
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Persistent Database Connection URI (MANDATORY IN PRODUCTION)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vruksha?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/vruksha?retryWrites=true&w=majority

# JWT Secret for Session & Authentication Tokens (MANDATORY IN PRODUCTION - Strong 32+ character random key)
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters

# JWT Expiration Lifetime
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

# WhatsApp Customer Support Number (international format with country code, no + or spaces)
WHATSAPP_PHONE_NUMBER=919573636998
