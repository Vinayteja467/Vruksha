# PUREHARVEST Server Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pureharvest?retryWrites=true&w=majority
# If omitted or offline, the server runs seamlessly using the built-in seed store engine.
MONGO_URI=mongodb+srv://demo:demo123@cluster0.example.mongodb.net/pureharvest?retryWrites=true&w=majority

# JWT Secret for user and admin authentication
JWT_SECRET=pureharvest_super_secure_jwt_secret_key_2026_d2c

# JWT Expiration
JWT_EXPIRES_IN=7d

# Razorpay Configuration (Keep keys private in production)
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Cloudinary Configuration for Image Uploads
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=pureharvest_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# WhatsApp Customer Support Number (with country code, no + or spaces)
# Used for B2B quotes and live product inquiries
WHATSAPP_PHONE_NUMBER=919876543210
