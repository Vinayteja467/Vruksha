# VRUKSHA Client Safe Environment Configuration
# Only VITE_ prefixed environment variables are bundled into the client build.
# NEVER put private database passwords or JWT secrets here.

# Backend API Base URL
# Leave empty in unified fullstack/proxy environments, or specify your backend server URL:
# Example: https://vruksha-api.onrender.com
VITE_API_URL=

# Public Razorpay Key ID (Safe to expose to client for checkout modal)
# Example: rzp_test_placeholder_key_id
VITE_RAZORPAY_KEY_ID=
