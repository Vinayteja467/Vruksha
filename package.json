{
  "name": "vruksha-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "VRUKSHA - Farm To Home Premium Natural Food Products E-Commerce Platform",
  "scripts": {
    "start": "node server/src/server.js",
    "build": "npm run build --prefix client",
    "vercel-build": "npm run build --prefix client",
    "install-all": "npm install && npm install --prefix server && npm install --prefix client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
